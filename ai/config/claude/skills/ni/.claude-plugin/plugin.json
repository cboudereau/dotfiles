{
  "name": "ni",
  "description": "ni, natural intelligence: a fresh, grounded set of engineering skills that keep the human in the loop. Say it nickel (French: spot on, good enough) or nice (UK/US). Terse replies by default, test-driven development, domain-driven design, git conventions, code and merge request reviews, .NET and Rust builds, planning for multi-session work, and evidence-based analysis that cites the code instead of guessing.",
  "version": "1.0.0",
  "author": {
    "name": "Clément Boudereau",
    "email": "cboudereau@gmail.com"
  },
  "homepage": "https://github.com/cboudereau/dotfiles",
