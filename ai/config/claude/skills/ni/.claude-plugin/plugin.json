  "keywords": [
    "ni",
    "natural-intelligence",
    "nickel",
    "nice",
    "terse",
    "skills",
    "tdd",
    "ddd",
    "git",
    "code-review",
    "gitlab",
    "dotnet",
    "rust",
    "planning",
    "evidence-based"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/terse-activate.sh\"",
            "timeout": 10,
            "statusMessage": "Loading ni terse mode..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/terse-reinforce.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
